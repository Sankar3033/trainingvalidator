# Production build config — committed on purpose (no secrets here; the API
# URL is public and ends up in the browser bundle anyway).
#
# Vite loads this only for `npm run build` (production mode), so local
# `npm run dev` still uses .env with an empty base URL and proxies /api to
# localhost:8000.
# NOTE: this is a deployment-specific Vercel URL, not the project alias. It
# changes on every new deployment, and it only works with Deployment
# Protection turned OFF (Project > Settings > Deployment Protection) —
# otherwise every API call 302s to vercel.com/sso-api and the app cannot
# reach the server. Re-point this after each backend deploy.
VITE_API_BASE_URL=https://trainingvalidatorbackend-1xte173qt-sankar3033s-projects.vercel.app

VITE_ORG_NAME=Schneider Electric
VITE_APP_SHORT_NAME=Training Validator
VITE_QR_PATH_PREFIX=/getInfo
