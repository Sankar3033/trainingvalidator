# ---------------------------------------------------------------------------
# Training Validator - frontend configuration
# Copy to ".env" for local dev. On Vercel add these under
# Project Settings -> Environment Variables (they must start with VITE_).
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash).
# local:  http://localhost:8000
# LAN (so a phone can reach it): http://192.168.1.50:8000
# vercel: https://your-backend-project.vercel.app
VITE_API_BASE_URL=http://localhost:8000

# Branding shown in the header and on printed badges
VITE_ORG_NAME=Schneider Training Validator
VITE_APP_SHORT_NAME=Training Validator

# Path segment used inside the QR code. Must match QR_PATH_PREFIX in the backend.
VITE_QR_PATH_PREFIX=/getInfo

# Serve the dev server over HTTPS with a self-signed certificate.
# Only needed to test the LIVE CAMERA on a phone over your LAN — mobile browsers
# block camera access on plain http://. If you enable this you must also serve
# the backend over HTTPS (see vite.config.js) or the browser blocks the API call
# as mixed content. The "Scan from photo" button works fine over plain HTTP.
VITE_DEV_HTTPS=false
